{
  "name": "hatex",
  "version": "1.2.1",
  "private": true,
  "description": "hatex = html + latex: LaTeX articles and beamer slides rendered in the browser. Maths, tables, figures, TikZ, theorems, algorithms, citations, two-column layouts.",
  "main": "dist/hatex.js",
  "module": "dist/hatex.mjs",
  "exports": {
    ".": {
      "import": "./dist/hatex.mjs",
      "require": "./dist/hatex.js"
    },
    "./hatex.css": "./dist/hatex.css"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "sync": "node scripts/sync.mjs",
    "prerender": "node examples/node/prerender.mjs"
  },
  "peerDependencies": {
    "katex": ">=0.16"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "devDependencies": {
    "katex": "0.16.9"
  },
  "license": "MIT"
}
